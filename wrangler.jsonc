{
  "name": "money-me-money-now",
  "compatibility_date": "2025-11-27",
  "main": "src/index.js",
  "assets": {
    "directory": "./dist"
  },
  "build": {
    "command": "npm run build",
    "cwd": "./"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}


